{
  "name": "xyroplay-netlify",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/netlify-build.mjs",
    "dev:local": "node scripts/netlify-local.mjs",
    "db:migrate:local": "node scripts/netlify-db.mjs migrate",
    "db:owner:local": "node scripts/netlify-db.mjs create-owner",
    "test:netlify": "node --test --test-concurrency=1 tests/netlify/*.test.mjs"
  },
  "dependencies": {
    "@netlify/database": "2.0.1",
    "ipaddr.js": "2.5.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
