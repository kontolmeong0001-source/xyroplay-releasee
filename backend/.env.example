# Set a private writable path; DB file and parent directory are permission restricted.
XYROPLAY_DB=/var/lib/xyroplay/xyroplay.sqlite3
# Configure only in the server environment; never expose this to clients.
SYNOX_API_KEY=
# Production origins default to Android WebView asset origin only.
# DEVELOPMENT=1 adds localhost:3000 and localhost:5173 origins.
DEVELOPMENT=0

# Exact browser origins, comma-separated; no wildcard.
XYRO_ALLOWED_ORIGINS=https://appassets.androidplatform.net

# Forwarded client IP/protocol headers are ignored unless deployed behind exactly one
# trusted proxy that overwrites them. Never set this when clients can reach Flask directly.
TRUST_PROXY_HOPS=0

# Retention policy: rate-limit buckets expire after 1 hour; security activity rows
# expire after 30 days (pruned on rate-limit operations). IPs are SHA-256 pseudonyms,
# not stored as plain address strings.
