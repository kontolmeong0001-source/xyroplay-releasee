# Contoh lokal saja, gunakan database PostgreSQL lokal milik sendiri.
# Jangan commit .env nyata atau masukkan koneksi ini ke web/config.js.
DATABASE_URL=postgresql://LOCAL_USER:LOCAL_PASSWORD@127.0.0.1:5432/xyroplay_local
# Izinkan koneksi tanpa TLS hanya untuk loopback pada pengembangan lokal.
XYRO_ALLOW_LOCAL_DB=true
# Opsional, kosong = alat pihak ketiga tidak aktif.
SYNOX_API_KEY=
# Same-origin web tidak memerlukan CORS; origin Android bawaan:
XYRO_ALLOWED_ORIGINS=https://appassets.androidplatform.net
